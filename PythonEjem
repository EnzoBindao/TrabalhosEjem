
import random

# Regras
print("O jogo funciona assim:")
print("- Você escolhe quanto deseja apostar.")
print("- Se sair todos os simbolos diferentes, perde a aposta.")
print("- Se sair 2 simbolos iguais, recebe 20% a mais.")
print("- Se sair 3 simbolos iguais, recebe 30% a mais.")

# Comecando o jogo
print("Vamos comecar!")
saldo = float(input("Digite o saldo que deseja: R$ "))

simbolos = ["👽", "👾", "😈", "☠️"]

# Iniciando as rodadas
while saldo > 0:

    print(f"\nSeu saldo atual e: R$ {saldo:.2f}")
    aposta = float(input("Informe sua aposta: R$ "))

    # Verificando se a aposta e valida
    while aposta <= 0 or aposta > saldo:
        print("Aposta invalida!")
        aposta = float(input("Informe outra aposta: R$ "))

    # Sorteando os simbolos
    v1 = random.choice(simbolos)
    v2 = random.choice(simbolos)
    v3 = random.choice(simbolos)

    print(v1, v2, v3)

    # Verificando o resultado
    if v1 == v2 == v3:
        print("PREMIO MAXIMO! Voce ganhou 30%!")
        ganho = aposta * 1.30

    elif v1 == v2 or v1 == v3 or v2 == v3:
        print("VOCE GANHOU 20%!")
        ganho = aposta * 1.20

    else:
        print("NAO GANHOU NADA!")
        ganho = 0

    # Atualizando o saldo
    saldo = saldo - aposta + ganho

    print(f"Valor recebido: R$ {ganho:.2f}")
    print(f"Seu saldo atual e: R$ {saldo:.2f}")

    # Perguntando se deseja continuar
    continuar = input("Deseja continuar? (s/n): ").lower()

    if continuar != "s":
        break

print(f"\nJogo encerrado! Saldo final: R$ {saldo:.2f}")
